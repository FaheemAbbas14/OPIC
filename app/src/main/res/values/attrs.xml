<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="ZoomRulerView">
        <attr name="zr_minZoom" format="float" />
        <attr name="zr_maxZoom" format="float" />
        <attr name="zr_step" format="float" />
        <attr name="zr_tickSpacing" format="dimension" />
        <attr name="zr_textSize" format="dimension" />
        <attr name="zr_pointerRadius" format="dimension" />
    </declare-styleable>
    <declare-styleable name="AngleLineView">
        <attr name="alv_angle" format="float" />
        <attr name="alv_angleOffset" format="float" />
        <attr name="alv_color" format="color" />
        <attr name="alv_strokeWidth" format="dimension" />
        <attr name="alv_lineLengthRatio" format="float" /> <!-- 0..1 -->
        <attr name="alv_roundCaps" format="boolean" />
        <attr name="alv_square" format="boolean" />
    </declare-styleable>
    <declare-styleable name="RotationLineOverlay">
        <!-- Visuals -->
        <attr name="lineColor" format="color" />
        <attr name="strokeWidth" format="dimension" />
        <attr name="centerLineLength" format="dimension" />
        <!-- Gap between center and each side line -->
        <attr name="sideGap" format="dimension" />
        <!-- Side line length -->
        <attr name="sideLength" format="dimension" />
        <!-- Behavior -->
        <attr name="smoothing" format="float" />           <!-- 0..1 (smaller = smoother) -->
        <attr name="angleOffset" format="float" />         <!-- degrees, e.g. +90 -->
        <attr name="inverted" format="boolean" />          <!-- flip 180° -->
        <attr name="mode" format="enum">
            <enum name="followDevice" value="0" />
            <enum name="fixed" value="1" />
        </attr>
        <attr name="fixedAngle" format="float" />          <!-- used when mode=fixed -->

        <!-- NEW: “line height” (stroke width) -->
        <attr name="centerStrokeWidth" format="dimension" />
        <attr name="sideStrokeWidth" format="dimension" />

        <!-- Optional colors -->
        <attr name="centerColor" format="color" />
        <attr name="sideColor" format="color" />

        <!-- Optional tuning -->
        <attr name="levelThreshold" format="float" />

        <attr name="rl_response" format="float"/>
        <attr name="rl_deadbandDeg" format="float"/>
        <attr name="rl_levelThresholdDeg" format="float"/>
        <attr name="rl_strokeWidth" format="dimension"/>
        <attr name="rl_normalColor" format="color"/>
        <attr name="rl_levelColor" format="color"/>
        <attr name="rl_centerInset" format="dimension" />
    </declare-styleable>
    <declare-styleable name="OpicTextView">
        <!-- existing attrs you already have... -->
        <attr name="leftLabel" format="string" />
        <attr name="rightLabel" format="string" />
        <attr name="initialIsVideo" format="boolean" />
        <attr name="trackColor" format="color" />
        <attr name="selectedColorStart" format="color" />
        <attr name="selectedColorEnd" format="color" />
        <attr name="textColor" format="color" />
        <attr name="selectedTextColor" format="color" />
        <attr name="cornerRadius" format="dimension" />
        <attr name="textSizeSp" format="dimension" />
        <attr name="opstrokeWidth" format="dimension" />
        <attr name="enableSlideAnimation" format="boolean" />
        <attr name="animationDurationMs" format="integer" />
        <attr name="opicText" format="string" />
        <!-- Optional: control text size from XML -->
        <attr name="opicTextSize" format="dimension" />
        <!-- NEW: space between options + inner padding for selected pill -->
        <attr name="segmentGap" format="dimension" />       <!-- default 6dp -->
        <attr name="segmentInset" format="dimension" />     <!-- default 2dp -->
    </declare-styleable>


</resources>