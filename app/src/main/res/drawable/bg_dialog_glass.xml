<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Cyan-only gradient (light -> base -> darker) -->
    <gradient
        android:angle="45"
        android:centerColor="#1CF3FF"
        android:endColor="#0FBFE6"
        android:startColor="#A6F7FF"
        android:type="linear" />

    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" /> <!-- subtle rim -->
</shape>
