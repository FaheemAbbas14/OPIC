<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#66000000" /> <!-- semi-transparent black -->

    <!-- Rounded corners -->
    <corners android:radius="12dp" />

    <!-- Optional stroke -->
    <stroke
        android:width="1dp"
        android:color="#FFFFFF" />

    <!-- Padding inside the shape (optional) -->
    <padding
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="4dp" />
</shape>
