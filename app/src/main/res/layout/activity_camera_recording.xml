<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:scaleType="fillCenter" />

    <!-- Rotate-to-landscape overlay -->
    <LinearLayout
        android:id="@+id/llRotationMessage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/rotateIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/refresh_2" />

        <TextView
            android:id="@+id/rotateMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Rotate your phone to Landscape"
            android:textColor="@android:color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Level / rotation overlay -->
    <com.example.myapplication.views.RotationLineOverlay
        android:id="@+id/lineOverlay"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clickable="false"
        android:focusable="false"
        android:visibility="visible"
        app:centerColor="@android:color/white"
        app:centerStrokeWidth="1dp"
        app:levelThreshold="1.0"
        app:sideColor="@android:color/white"
        app:sideGap="80dp"
        app:sideLength="24dp"
        app:sideStrokeWidth="1dp"
        app:smoothing="0.15" />

    <!-- Tap-to-focus ring -->
    <View
        android:id="@+id/focusRing"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="top|start"
        android:background="@drawable/camera"
        android:backgroundTint="@color/white"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Right-side vertical controls -->
        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp">

            <!-- NEW: Photo/Video toggle -->
            <!--            <TextView-->
            <!--                android:id="@+id/modeToggle"-->
            <!--                android:layout_width="wrap_content"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:layout_marginBottom="@dimen/_10sdp"-->
            <!--                android:background="@drawable/rounded_toggle_bg"-->
            <!--                android:contentDescription="Toggle Photo or Video mode"-->
            <!--                android:paddingLeft="@dimen/_10sdp"-->
            <!--                android:paddingTop="@dimen/_6sdp"-->
            <!--                android:paddingRight="@dimen/_10sdp"-->
            <!--                android:paddingBottom="@dimen/_6sdp"-->
            <!--                android:text="VIDEO"-->
            <!--                android:textAllCaps="true"-->
            <!--                android:textColor="@android:color/white"-->
            <!--                android:textStyle="bold" />-->

            <ImageButton
                android:id="@+id/videoPauseResume"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/_10sdp"
                android:background="@drawable/pause"
                android:contentDescription="Capture button"
                android:padding="@dimen/_14sdp"
                android:scaleType="centerInside"
                android:visibility="gone" />

            <TextView
                android:id="@+id/stopButton"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/_10sdp"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:scaleType="centerInside"
                android:text="AF"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:visibility="visible" />

            <ImageButton
                android:id="@+id/videobutton"
                android:layout_width="@dimen/_62sdp"
                android:layout_height="@dimen/_62sdp"
                android:background="@drawable/circle_button_bg"
                android:contentDescription="Capture button"
                android:padding="@dimen/_14sdp"
                android:scaleType="centerInside" />

            <ImageView
                android:id="@+id/videobuttonblack"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/ring_circle_black1"
                android:contentDescription="Zoom / search"
                android:src="@drawable/searchsvg" />
        </LinearLayout>

        <!-- OPIC label (rotated) -->
        <!--        <com.example.myapplication.OpicTextView-->
        <!--            android:id="@+id/tv_opic_spartial"-->
        <!--            android:layout_width="@dimen/_80sdp"-->
        <!--            android:layout_height="@dimen/_24sdp"-->
        <!--            android:layout_gravity="end|center_vertical"-->
        <!--            android:layout_marginEnd="@dimen/_90sdp"-->
        <!--            android:padding="@dimen/_2sdp"-->
        <!--            android:rotation="270"-->
        <!--            android:visibility="gone"-->
        <!--            android:textSize="@dimen/_11ssp"-->
        <!--            android:textStyle="bold" />-->
        <com.example.myapplication.views.OPICToggler
            android:id="@+id/mediaToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="15dp"
            android:padding="6dp"
            android:rotation="270"
            android:visibility="gone"
            app:animationDurationMs="180"
            app:enableSlideAnimation="true"
            app:initialIsVideo="true"
            app:leftLabel="OPIC Video"
            app:rightLabel="OPIC Photo"
            app:segmentGap="6dp"
            app:segmentInset="2dp"
            app:selectedColorEnd="#FD2F55"
            app:selectedColorStart="#1CF3FF"
            app:selectedTextColor="#FF000000"
            app:textColor="#FFFFFFFF"
            app:textSizeSp="14sp"
            app:trackColor="#1AFFFFFF" />

        <!--        <androidx.recyclerview.widget.RecyclerView-->
        <!--            android:id="@+id/rvMode"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_gravity="end|center_vertical"-->
        <!--            android:layout_marginEnd="20dp"-->
        <!--            android:clipToPadding="false"-->
        <!--            android:orientation="horizontal"-->
        <!--            android:paddingStart="10dp"-->
        <!--            android:rotation="270" />-->
        <!--        <androidx.recyclerview.widget.RecyclerView-->
        <!--            android:id="@+id/rvMode"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_gravity="center"-->
        <!--            android:clipToPadding="false"-->
        <!--            android:rotation="270" />-->
        <com.example.myapplication.views.NoBounceRecyclerView
            android:id="@+id/rvMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:rotation="270" />
        <Spinner
            android:id="@+id/spnOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/_130sdp"
            android:layout_gravity="top|center_horizontal"
            android:paddingStart="10dp"
            android:layout_marginTop="10dp" />

        <!-- Manual focus ruler -->
        <com.example.myapplication.FocusRulerView
            android:id="@+id/focusScaleView"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/_130sdp"
            android:visibility="gone"
            app:zr_maxZoom="1.00"
            app:zr_minZoom="0.00"
            app:zr_pointerRadius="4dp"
            app:zr_step="0.02"
            app:zr_textSize="10sp"
            app:zr_tickSpacing="9dp" />

        <!-- Zoom ruler -->
        <com.example.myapplication.views.ZoomRulerView
            android:id="@+id/zoomRulerView"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/_130sdp"
            app:zr_maxZoom="5.0"
            app:zr_minZoom="1.0"
            app:zr_pointerRadius="4dp"
            app:zr_step="0.1"
            app:zr_textSize="10sp"
            app:zr_tickSpacing="9dp" />

        <!-- Zoom quick-presets container -->
        <LinearLayout
            android:id="@+id/zoomControlBg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/_140sdp"
            android:background="@drawable/bg_zoom_container_control"
            android:orientation="vertical"
            android:paddingTop="@dimen/_1sdp"
            android:paddingBottom="@dimen/_1sdp"
            android:visibility="visible">

            <com.example.myapplication.SwipeDetectRecyclerView
                android:id="@+id/zoomControlRecyclerView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                tools:itemCount="5"
                tools:listitem="@layout/item_zoom_control_level" />
        </LinearLayout>

    </FrameLayout>

    <!-- Timer -->
    <com.example.myapplication.views.GlowingTimerView
        android:id="@+id/glowTimer"
        android:layout_width="@dimen/_70sdp"
        android:layout_height="@dimen/_26sdp"
        android:layout_gravity="top|center_horizontal"
        android:layout_margin="12dp"
        android:layout_marginTop="32dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="00:00:00"
        android:textSize="@dimen/_18sdp"
        android:visibility="visible" />
    <TextView
        android:id="@+id/pickImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:layout_marginEnd="@dimen/_130sdp"
        android:layout_gravity="top|center_horizontal"
        android:paddingStart="10dp"
        android:layout_marginTop="30dp"
        android:text="Pick Image"
        android:textColor="@color/white"
        android:textSize="@dimen/_10ssp"
        android:textStyle="bold"
        android:visibility="gone" />
    <!-- Left icons (currently hidden) -->
    <LinearLayout
        android:id="@+id/leftPanel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:layout_marginRight="@dimen/_4sdp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/resolutionIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Resolution"
            android:src="@drawable/maximize_icon"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/hdrIcon"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginTop="16dp"
            android:contentDescription="HDR"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/flash"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/stabilizeIcon"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginTop="16dp"
            android:contentDescription="Stabilization"
            android:src="@drawable/refresh_2"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/micIcon"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginTop="16dp"
            android:contentDescription="Mute Mic"
            android:src="@drawable/timer_start__1"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom container (free for future controls) -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/_4sdp"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp" />

</FrameLayout>
